{
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/models/(.*)\\.glb",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/panoramas/(.*)\\.(jpg|jpeg|png|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
