rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Colección principal del edificio (calibración 3D y puntos espaciales)
    match /edificio/{document=**} {
      // Cualquier visitante puede visualizar el edificio, su calibración y sus puntos
      allow read: if true;

      // Solo administradores autenticados vía Firebase Authentication pueden escribir.
      // Si se registran usuarios no administradores en el futuro, restringir mediante
      // Custom Claims (request.auth.token.admin == true) o una colección /admins/{uid}.
      allow write: if request.auth != null;
    }

    // Denegar cualquier otra ruta por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
